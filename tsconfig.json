{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ESNext"
		],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"ignoreDeprecations": "6.0",
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"paths": {
			"@translate/*": [
				"plugins/translate/src/*"
			],
			"@aussie-mode/*": [
				"plugins/aussie-mode/src/*"
			],
			"@reviewdb/*": [
				"plugins/reviewdb/src/*"
			]
		},
		"noEmit": true
	},
	"include": [
		"plugins",
		"themes",
		"scripts"
	]
}