{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ESNext"
		],
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"ignoreDeprecations": "6.0",
		"allowImportingTsExtensions": true,
		"baseUrl": ".",
		"paths": {
			"@character-counter/*": [
				"plugins/character-counter/src/*"
			],
			"@reaction-avatars/*": [
				"plugins/reaction-avatars/src/*"
			],
			"@aussie-speech/*": [
				"plugins/aussie-speech/src/*"
			],
			"@mention-avatars/*": [
				"plugins/mention-avatars/src/*"
			],
			"@fix-gif-download/*": [
				"plugins/fix-gif-download/src/*"
			],
			"@shared/*": [
				"shared/*"
			],
			"@text-replace/*": [
				"plugins/text-replace/src/*"
			],
			"@translate/*": [
				"plugins/translate/src/*"
			],
			"@aussie-mode/*": [
				"plugins/aussie-mode/src/*"
			],
			"@reviewdb/*": [
				"plugins/reviewdb/src/*"
			],
			"@no-blocked-messages/*": [
				"plugins/no-blocked-messages/src/*"
			],
			"@show-me-your-name/*": [
				"plugins/show-me-your-name/src/*"
			],
			"@force-owner-crown/*": [
				"plugins/force-owner-crown/src/*"
			],
			"@clear-urls/*": [
				"plugins/clear-urls/src/*"
			],
			"@typing-avatars/*": [
				"plugins/typing-avatars/src/*"
			],
			"@no-reply-mention/*": [
				"plugins/no-reply-mention/src/*"
			],
			"@more-user-tags/*": [
				"plugins/more-user-tags/src/*"
			],
			"@preview-message/*": [
				"plugins/preview-message/src/*"
			],
			"@message-link-embeds/*": [
				"plugins/message-link-embeds/src/*"
			],
			"@scripts/*": [
				"scripts/*"
			]
		},
		"noEmit": true
	},
	"include": [
		"plugins",
		"themes",
		"scripts"
	]
}
