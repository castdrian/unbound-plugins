{
	"name": "unbound-plugins",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"plugins/*",
		"shared/*",
		"themes/*"
	],
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"dev": "ubd dev",
		"build": "ubd build",
		"check:native": "bun scripts/check-native-migration.ts",
		"format": "biome format --write plugins",
		"format:check": "biome format plugins",
		"postbuild": "bun scripts/generate-plugins-readme.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@unbound-app/cli": "latest",
		"@unbound-plugins/rollup-path-aliases": "workspace:*"
	}
}
