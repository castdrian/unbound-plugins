{
	"name": "unbound-plugins",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"plugins/*",
		"themes/*"
	],
	"scripts": {
		"prepare": "git config core.hooksPath .githooks || true",
		"dev": "ubd dev",
		"build": "ubd build",
		"test:text-replace": "bun test plugins/text-replace scripts/text-replace-harness.test.ts scripts/extract-hermes-bundle.test.ts",
		"extract:hermes": "bun scripts/extract-hermes-bundle.ts",
		"package": "bun scripts/package-clean.ts",
		"postbuild": "bun scripts/generate-plugins-readme.ts"
	},
	"devDependencies": {
		"@unbound-app/cli": "latest",
		"typescript": "6.0.3"
	}
}
